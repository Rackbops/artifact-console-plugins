{
  "name": "@rackbops/ac-plugin-hello-remote",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "The reference third-party plugin: one panel, one card, GET /ping. Proves the artifact-console-plugins install path (#105).",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/server.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rackbops/artifact-console-plugins.git",
    "directory": "plugins/hello-remote"
  },
  "acPlugin": {
    "id": "hello-remote",
    "hostApiVersion": 1,
    "kind": "in-process",
    "server": "dist/server.js",
    "frontend": "dist/ui.js",
    "contributes": {
      "panels": [
        {
          "id": "hello-remote-panel",
          "title": "Hello (remote)",
          "route": "/hello-remote",
          "export": "HelloRemotePanel"
        }
      ],
      "cards": [
        {
          "id": "hello-remote-card",
          "title": "Hello (remote)",
          "sizes": [
            "2x1"
          ],
          "export": "HelloRemoteCard"
        }
      ],
      "routes": [
        {
          "method": "GET",
          "path": "/ping"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.ui.build.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@rackbops/ac-plugin-contract": "catalog:",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "^30.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
