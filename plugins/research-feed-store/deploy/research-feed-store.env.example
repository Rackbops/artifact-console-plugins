# Copy to research-feed-store.env next to your compose.yaml, fill in the blanks, then
# `chmod 600 research-feed-store.env` -- this file holds credentials, so keep it out of git and
# readable only by the account that runs docker compose.

# The research-triage feed's origin.
RESEARCH_FEED_URL=

# The bearer token minted by `npm run feed:mint-token` in research-triage.
RESEARCH_FEED_TOKEN=

# The Cloudflare Access service token pair for rt.rackbops.com's non_identity policy. Optional --
# leave both blank against a feed with no Access gate in front of it (e.g. a local stub).
RESEARCH_FEED_ACCESS_CLIENT_ID=
RESEARCH_FEED_ACCESS_CLIENT_SECRET=

# Poll interval in seconds. Default 300, minimum 30.
RESEARCH_FEED_POLL_SECONDS=

# Absolute path to the SQLite db file inside the container. Default /data/research-feed.db --
# leave blank unless you've also changed the compose fragment's volume mount.
RESEARCH_FEED_DB=
